# macOS metadata files
.DS_Store

# Windows metadata files
Thumbs.db
Desktop.ini

# -----------------------------------------------
# IDEs and editors
# -----------------------------------------------

# JetBrains IDEs (PyCharm, IntelliJ, etc.)
.idea/

# Visual Studio Code
.vscode/

# Swap and backup files
*~
*.swp
*.swo

# -----------------------------------------------
# Python
# -----------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
.eggs/
*.egg-info/
*.egg

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.pytest_cache/
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints/

# IPython
profile_default/
ipython_config.py

# Python version
#   Commit .python-version to ensure all contributors use the same Python version.
# .python-version

# uv
#   Commit uv.lock to ensure reproducible dependency installations across the team.
# uv.lock

# Virtual environments
.venv/
env/
venv/

# Environment variables / secrets
.env
.env.*
!.env.example

# mypy
.mypy_cache/

# Pyre type checker
.pyre/

# Ruff stuff:
.ruff_cache/

