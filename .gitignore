# -----------------------------------------------
# Operating System files
# -----------------------------------------------

# macOS metadata files
.DS_Store

# Windows metadata files
Thumbs.db
Desktop.ini

# -----------------------------------------------
# IDEs and editors
# -----------------------------------------------

# JetBrains IDEs (PyCharm, IntelliJ, etc.)
.idea/

# Visual Studio Code
.vscode/

# Swap and backup files
*~
*.swp
*.swo

# -----------------------------------------------
# Python
# -----------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
.eggs/
*.egg-info/
*.egg

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.pytest_cache/
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints/

# IPython
profile_default/
ipython_config.py

# Python version
#   Commit .python-version to ensure all contributors use the same Python version.
# .python-version

# uv
#   Commit uv.lock to ensure reproducible dependency installations across the team.
# uv.lock

# Virtual environments
.venv/
env/
venv/

# Environment variables / secrets
.env
.env.*
!.env.example

# mypy
.mypy_cache/

# Pyre type checker
.pyre/

# Ruff stuff:
.ruff_cache/

# -----------------------------------------------
# R
# -----------------------------------------------

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# Default plot file written by Rscript when a plot is displayed but not saved
Rplots.pdf

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# Quarto render output in R/
#   Rendering a .qmd writes its report and helper files next to it. Rendered
#   reports are kept in reports/eda/ instead, so only the .qmd sources are
#   committed here.
R/*.html
R/*.pdf
R/*.tex
R/*_files/

# R Environment Variables
.Renviron

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# -----------------------------------------------
# LaTeX
# -----------------------------------------------

# Auxiliary files
*.aux
*.bbl
*.bcf
*.blg
*.idx
*.ilg
*.ind
*.lof
*.lot
*.out
*.toc
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.ist
*.fls
*.log
*.fdb_latexmk
*.synctex.gz
*.synctex.gz(busy)
*.xdv

# Bibliography
*.run.xml

# Minted (code highlighting)
_minted*
*.pyg

# TikZ / externalization
*.dpth
*.md5
*.auxlock

# Beamer / presentations
*.nav
*.snm

# Overleaf artifacts
*.latexmain

# -----------------------------------------------
# Miscellaneous
# -----------------------------------------------

# Temporary files
*.tmp
*.temp

# Makefile empty target files, containing a timestamp
*.stamp

# -----------------------------------------------
# Datasets
# -----------------------------------------------

# Raw datasets
#   Counter-Strike demos (.dem) can exceed GitHub's 100 MiB file limit. Ignore
#   raw datasets by default. Smaller files may be committed later if useful for
#   reproducibility; update these rules accordingly.
*.dem
/data/raw/*
!/data/raw/.gitkeep

# Processed datasets
#   Small generated datasets may be committed for reproducibility.
#   Reconsider this policy if datasets become substantially larger.
#/data/processed/*
#!/data/processed/.gitkeep
