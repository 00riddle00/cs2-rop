# macOS
.DS_Store

# Windows
Thumbs.db

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
.eggs/
*.egg-info/
*.egg

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.pytest_cache/
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints/

# IPython
profile_default/
ipython_config.py

# Python version
#   Commit .python-version to ensure all contributors use the same Python version.
# .python-version

# uv
#   Commit uv.lock to ensure reproducible dependency installations across the team.
# uv.lock

# Virtual environments
.venv/
env/
venv/

# Environment variables / secrets
.env
.env.*
!.env.example

# mypy
.mypy_cache/

# Pyre type checker
.pyre/

# Ruff stuff:
.ruff_cache/

# IDEs
.idea/
.vscode/

# Go binaries and test artifacts
/bin/
*.test

# Raw datasets
#   Counter-Strike demos can exceed GitHub's 100 MiB file limit.
#   Ignore raw datasets by default. Smaller files may be committed later
#   if useful for reproducibility; update these rules accordingly.
*.dem
/data/raw/*
!/data/raw/.gitkeep

# Processed datasets
#   Small generated datasets may be committed for reproducibility.
#   Reconsider this policy if datasets become substantially larger.
#/data/processed/*
#!/data/processed/.gitkeep
